<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MaternaApp.Views.LoginGestantePage"
             BackgroundColor="#F5F8F7"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0"
              BackgroundColor="#1A9E85"
              Padding="20,10,20,16"
              RowDefinitions="Auto,Auto"
              RowSpacing="10">

            <Button Text="‹ Voltar"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start"
                    FontSize="14"
                    Padding="0"
                    HeightRequest="32"
                    Clicked="OnVoltarClicked"/>

            <HorizontalStackLayout Grid.Row="1"
                                   Spacing="12"
                                   VerticalOptions="Center">

                <Border WidthRequest="46"
                        HeightRequest="46"
                        BackgroundColor="#FFFFFF"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 14">

                    <Label Text="🤰"
                           FontSize="23"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Spacing="3"
                                     VerticalOptions="Center">

                    <Label Text="Acesso da gestante"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="Seu cuidado, sempre com você."
                           FontSize="12"
                           TextColor="#E1F5F0"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,18"
                                 Spacing="14">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Entre na sua conta"
                           FontSize="21"
                           FontAttributes="Bold"
                           TextColor="#243B3A"/>

                    <Label Text="Informe seus dados para continuar."
                           FontSize="13"
                           TextColor="#718582"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Identificação"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#344B48"/>

                    <Border BackgroundColor="#E6EFEC"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 11"
                            Padding="4">

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="4">

                            <Button x:Name="btnCpf"
                                    Text="CPF"
                                    BackgroundColor="White"
                                    TextColor="#168A75"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="38"
                                    Clicked="OnSelectCpf"/>

                            <Button x:Name="btnSus"
                                    Grid.Column="1"
                                    Text="Cartão SUS"
                                    BackgroundColor="Transparent"
                                    TextColor="#718582"
                                    CornerRadius="8"
                                    HeightRequest="38"
                                    Clicked="OnSelectSus"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label x:Name="lblTipoDoc"
                           Text="CPF"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#344B48"/>

                    <Border BackgroundColor="White"
                            Stroke="#DCE7E3"
                            StrokeShape="RoundRectangle 11"
                            Padding="12,0"
                            HeightRequest="46">

                        <Entry x:Name="txtDocumento"
                               Placeholder="Digite seu CPF"
                               TextColor="#243B3A"
                               PlaceholderColor="#9AABA7"
                               Keyboard="Numeric"
                               VerticalOptions="Center"
                               ClearButtonVisibility="WhileEditing"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Senha"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#344B48"/>

                    <Border BackgroundColor="White"
                            Stroke="#DCE7E3"
                            StrokeShape="RoundRectangle 11"
                            Padding="12,0"
                            HeightRequest="46">

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="6">

                            <Entry x:Name="txtSenha"
                                   Placeholder="Digite sua senha"
                                   TextColor="#243B3A"
                                   PlaceholderColor="#9AABA7"
                                   IsPassword="True"
                                   VerticalOptions="Center"
                                   ReturnType="Go"
                                   Completed="OnEntrarClicked"/>

                            <Label x:Name="lblOlho"
                                   Grid.Column="1"
                                   Text="◉"
                                   FontSize="20"
                                   TextColor="#718582"
                                   VerticalOptions="Center"
                                   Padding="6">

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMostrarSenhaTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Button Text="Entrar"
                        BackgroundColor="#1A9E85"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="11"
                        HeightRequest="46"
                        Clicked="OnEntrarClicked"/>

                <Label Text="Problemas para acessar? Procure sua UBS."
                       FontSize="12"
                       TextColor="#718582"
                       HorizontalTextAlignment="Center"/>

                <Label Text="MotherLink"
                       FontSize="11"
                       TextColor="#91A29D"
                       HorizontalTextAlignment="Center"
                       Margin="0,2,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
