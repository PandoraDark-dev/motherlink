<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MaternaApp.Views.AgendaPage"
             BackgroundColor="#F0F8F6"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="15" Padding="20,40,20,20">

                <VerticalStackLayout>
                    <Label x:Name="lblAno" FontSize="12" TextColor="#7F8C8D"/>
                    <Label x:Name="lblMes" FontSize="24" FontAttributes="Bold" TextColor="#2C3E50"/>
                </VerticalStackLayout>

                <Border BackgroundColor="White" Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                            <Label Text="Dom" HorizontalTextAlignment="Center" FontSize="11" TextColor="#7F8C8D"/>
                            <Label Grid.Column="1" Text="Seg" HorizontalTextAlignment="Center" FontSize="11" TextColor="#7F8C8D"/>
                            <Label Grid.Column="2" Text="Ter" HorizontalTextAlignment="Center" FontSize="11" TextColor="#7F8C8D"/>
                            <Label Grid.Column="3" Text="Qua" HorizontalTextAlignment="Center" FontSize="11" TextColor="#7F8C8D"/>
                            <Label Grid.Column="4" Text="Qui" HorizontalTextAlignment="Center" FontSize="11" TextColor="#7F8C8D"/>
                            <Label Grid.Column="5" Text="Sex" HorizontalTextAlignment="Center" FontSize="11" TextColor="#7F8C8D"/>
                            <Label Grid.Column="6" Text="Sáb" HorizontalTextAlignment="Center" FontSize="11" TextColor="#7F8C8D"/>
                        </Grid>

                        <Grid x:Name="CalendarioGrid"
                              ColumnDefinitions="*,*,*,*,*,*,*"
                              RowSpacing="10"
                              ColumnSpacing="0"/>

                    </VerticalStackLayout>
                </Border>

                <Label Text="PRÓXIMAS CONSULTAS"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#7F8C8D"
                       Margin="0,5,0,0"/>

                <VerticalStackLayout x:Name="ConsultasContainer" Spacing="12"/>

                <Label x:Name="lblSemConsultas"
                       Text="Você ainda não possui consultas agendadas."
                       FontSize="13"
                       TextColor="#7F8C8D"
                       HorizontalTextAlignment="Center"
                       Margin="0,10"
                       IsVisible="False"/>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              BackgroundColor="White"
              HeightRequest="60"
              ColumnDefinitions="*,*,*,*,*">

            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnInicioTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="🏠" FontSize="16" HorizontalOptions="Center" InputTransparent="True"/>
                <Label Text="Início" FontSize="10" TextColor="#7F8C8D" HorizontalOptions="Center" InputTransparent="True"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="📅" FontSize="16" HorizontalOptions="Center"/>
                <Label Text="Agenda" FontSize="10" TextColor="#1A9E85" FontAttributes="Bold" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="💬" FontSize="16" HorizontalOptions="Center"/>
                <Label Text="Chat" FontSize="10" TextColor="#7F8C8D" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="📖" FontSize="16" HorizontalOptions="Center"/>
                <Label Text="Guia" FontSize="10" TextColor="#7F8C8D" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="4" VerticalOptions="Center" HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPerfilTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="👤" FontSize="16" HorizontalOptions="Center" InputTransparent="True"/>
                <Label Text="Perfil" FontSize="10" TextColor="#7F8C8D" HorizontalOptions="Center" InputTransparent="True"/>
            </VerticalStackLayout>

        </Grid>
    </Grid>

</ContentPage>
