<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MaternaApp.Views.GerenciarSuplementosPage"
             BackgroundColor="#F2F9F8"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <Grid Padding="20" BackgroundColor="#17685F"
              ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="4">
                <Label Text="Gerenciar suplementos"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"/>
                <Label x:Name="lblNomeGestante"
                       FontSize="13"
                       TextColor="#D2EAE5"/>
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Voltar"
                    BackgroundColor="#43877F"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="OnVoltarClicked"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="18">

                <Frame Padding="18"
                       CornerRadius="14"
                       HasShadow="False"
                       BackgroundColor="White">
                    <VerticalStackLayout Spacing="12">

                        <Label x:Name="lblTituloFormulario"
                               Text="Cadastrar suplemento"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#244A45"/>

                        <Label Text="Nome do suplemento"
                               FontSize="12"
                               TextColor="#526B66"/>
                        <Entry x:Name="txtNomeSuplemento"
                               Placeholder="Ex.: Ácido fólico"
                               BackgroundColor="#F2F9F8"
                               TextColor="#244A45"
                               PlaceholderColor="#91A39E"/>

                        <Label Text="Dosagem"
                               FontSize="12"
                               TextColor="#526B66"/>
                        <Entry x:Name="txtDosagemSuplemento"
                               Placeholder="Ex.: 400 mcg"
                               BackgroundColor="#F2F9F8"
                               TextColor="#244A45"
                               PlaceholderColor="#91A39E"/>

                        <Label Text="Horários das doses"
                               FontSize="12"
                               TextColor="#526B66"/>
                        <Entry x:Name="txtHorariosSuplemento"
                               Placeholder="Ex.: 08:00, 20:00"
                               BackgroundColor="#F2F9F8"
                               TextColor="#244A45"
                               PlaceholderColor="#91A39E"/>

                        <Label Text="Orientações"
                               FontSize="12"
                               TextColor="#526B66"/>
                        <Editor x:Name="txtOrientacoesSuplemento"
                                Placeholder="Orientações para a gestante"
                                AutoSize="TextChanges"
                                BackgroundColor="#F2F9F8"
                                TextColor="#244A45"
                                PlaceholderColor="#91A39E"/>

                        <Button x:Name="btnSalvarSuplemento"
                                Text="Cadastrar suplemento"
                                BackgroundColor="#319C8C"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="48"
                                Clicked="OnSalvarSuplementoClicked"/>

                        <Button x:Name="btnCancelarEdicao"
                                Text="Cancelar edição"
                                IsVisible="False"
                                BackgroundColor="#E8EFED"
                                TextColor="#526B66"
                                CornerRadius="10"
                                Clicked="OnCancelarEdicaoClicked"/>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Suplementos cadastrados"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#244A45"/>

                <CollectionView x:Name="ListaSuplementosProfissional"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Nenhum suplemento cadastrado para esta gestante."
                               TextColor="#81938F"
                               HorizontalTextAlignment="Center"
                               Margin="10"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="15"
                                   Margin="0,5"
                                   CornerRadius="12"
                                   HasShadow="False"
                                   BackgroundColor="White"
                                   BorderColor="#E1EEEA">
                                <VerticalStackLayout Spacing="8">

                                    <Label Text="{Binding Nome}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#244A45"/>

                                    <Label Text="{Binding Dosagem, StringFormat='Dosagem: {0}'}"
                                           FontSize="13"
                                           TextColor="#526B66"/>

                                    <Label Text="{Binding Horarios, StringFormat='Horários: {0}'}"
                                           FontSize="13"
                                           TextColor="#526B66"/>

                                    <Label Text="{Binding Orientacoes, StringFormat='Orientações: {0}'}"
                                           FontSize="13"
                                           TextColor="#526B66"/>

                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="10">
                                        <Button Text="Editar"
                                                BackgroundColor="#347F80"
                                                TextColor="White"
                                                CornerRadius="8"
                                                Clicked="OnEditarSuplementoClicked"/>

                                        <Button Grid.Column="1"
                                                Text="Excluir"
                                                BackgroundColor="#D96C6C"
                                                TextColor="White"
                                                CornerRadius="8"
                                                Clicked="OnExcluirSuplementoClicked"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>