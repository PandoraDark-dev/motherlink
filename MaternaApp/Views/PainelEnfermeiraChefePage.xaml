<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MaternaApp.Views.PainelEnfermeiraChefePage"
             BackgroundColor="#F2F9F8"
             NavigationPage.HasNavigationBar="False">

    <Grid ColumnDefinitions="210,310,*">

        <VerticalStackLayout Grid.Column="0"
                             BackgroundColor="#17685F"
                             Padding="20,30"
                             Spacing="24">

            <VerticalStackLayout Spacing="4">
                <Label Text="MotherLink"
                       FontSize="25"
                       FontAttributes="Bold"
                       TextColor="White"/>

                <Label Text="GESTÃO DE SAÚDE"
                       FontSize="10"
                       TextColor="#B8D8D2"/>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#FFFFFF30"/>

            <VerticalStackLayout Spacing="16">
                <Label Text="GESTÃO"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#B8D8D2"/>

                <Label Text="♙  Profissionais"
                       TextColor="White"
                       FontSize="14"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>

            <VerticalStackLayout VerticalOptions="EndAndExpand">
                <Button Text="↪ Sair"
                        BackgroundColor="#C94B4B"
                        TextColor="White"
                        CornerRadius="8"
                        Clicked="OnSairClicked"/>
            </VerticalStackLayout>

        </VerticalStackLayout>

        <Grid Grid.Column="1"
              BackgroundColor="White"
              RowDefinitions="Auto,Auto,*"
              Padding="18">

            <Label Text="Equipe de saúde"
                   FontSize="21"
                   FontAttributes="Bold"
                   TextColor="#244A45"/>

            <Button Grid.Row="1"
                    Text="+ Novo profissional"
                    BackgroundColor="#17685F"
                    TextColor="White"
                    CornerRadius="8"
                    Margin="0,18,0,12"
                    Clicked="OnAbrirCadastroClicked"/>

            <CollectionView x:Name="ListaProfissionais"
                            Grid.Row="2"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label Text="Nenhum profissional cadastrado."
                           TextColor="#81938F"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#F2F9F8"
                                Stroke="#E1ECE9"
                                StrokeThickness="1"
                                Padding="12"
                                Margin="0,5"
                                StrokeShape="RoundRectangle 10">

                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Nome}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       TextColor="#244A45"/>

                                <Label Text="{Binding Especialidade}"
                                       FontSize="12"
                                       TextColor="#81938F"/>

                                <Label Text="{Binding Email}"
                                       FontSize="11"
                                       TextColor="#81938F"/>
                            </VerticalStackLayout>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </Grid>

        <ScrollView Grid.Column="2">
            <VerticalStackLayout Padding="30"
                                 Spacing="22">

                <VerticalStackLayout Spacing="5">
                    <Label Text="Painel da Enfermeira-Chefe"
                           FontSize="27"
                           FontAttributes="Bold"
                           TextColor="#244A45"/>

                    <Label Text="Gerencie a equipe de profissionais da unidade."
                           FontSize="14"
                           TextColor="#81938F"/>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="16">

                    <Border BackgroundColor="White"
                            Stroke="#E1ECE9"
                            Padding="20"
                            StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Profissionais"
                                   TextColor="#81938F"
                                   FontSize="13"/>

                            <Label x:Name="lblTotalProfissionais"
                                   Text="0"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   TextColor="#17685F"/>

                            <Label Text="Cadastrados na unidade"
                                   FontSize="11"
                                   TextColor="#81938F"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E1ECE9"
                            Padding="20"
                            StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Enfermeira-chefe"
                                   TextColor="#81938F"
                                   FontSize="13"/>

                            <Label Text="Maria Eduarda"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#17685F"/>

                            <Label Text="Responsável pela equipe"
                                   FontSize="11"
                                   TextColor="#81938F"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <Border BackgroundColor="White"
                        Stroke="#E1ECE9"
                        Padding="22"
                        StrokeShape="RoundRectangle 12">

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Gestão da equipe"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="#244A45"/>

                        <Label Text="Gerencie os profissionais cadastrados na unidade de saúde e mantenha a equipe organizada."
                               FontSize="14"
                               TextColor="#81938F"/>
                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="ModalCadastroGrid"
              Grid.ColumnSpan="3"
              BackgroundColor="#80000000"
              IsVisible="False"
              Padding="20">

            <Border BackgroundColor="White"
                    Padding="22"
                    WidthRequest="430"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 16">

                <ScrollView>
                    <VerticalStackLayout Spacing="13">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Novo profissional"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#244A45"/>

                            <Button Grid.Column="1"
                                    Text="✕"
                                    BackgroundColor="Transparent"
                                    TextColor="#81938F"
                                    Clicked="OnFecharCadastroClicked"/>
                        </Grid>

                        <Entry x:Name="txtNome"
                               Placeholder="Nome completo"
                               TextColor="#244A45"
                               PlaceholderColor="#91A39E"
                               BackgroundColor="#F2F9F8"/>

                        <Entry x:Name="txtCPF"
                               Placeholder="CPF"
                               Keyboard="Numeric"
                               MaxLength="11"
                               TextColor="#244A45"
                               PlaceholderColor="#91A39E"
                               BackgroundColor="#F2F9F8"/>

                        <Entry x:Name="txtRegistro"
                               Placeholder="COREN ou CRM"
                               TextColor="#244A45"
                               PlaceholderColor="#91A39E"
                               BackgroundColor="#F2F9F8"/>

                        <Entry x:Name="txtEspecialidade"
                               Placeholder="Especialidade"
                               TextColor="#244A45"
                               PlaceholderColor="#91A39E"
                               BackgroundColor="#F2F9F8"/>

                        <Entry x:Name="txtEmail"
                               Placeholder="E-mail"
                               Keyboard="Email"
                               TextColor="#244A45"
                               PlaceholderColor="#91A39E"
                               BackgroundColor="#F2F9F8"/>

                        <Entry x:Name="txtSenha"
                               Placeholder="Senha"
                               IsPassword="True"
                               TextColor="#244A45"
                               PlaceholderColor="#91A39E"
                               BackgroundColor="#F2F9F8"/>

                        <Button Text="Cadastrar profissional"
                                BackgroundColor="#319C8C"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="48"
                                Clicked="OnSalvarProfissionalClicked"/>

                    </VerticalStackLayout>
                </ScrollView>

            </Border>
        </Grid>

    </Grid>
</ContentPage>
