<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MaternaApp.Views.GuiaPartoPage"
    Title="Plano de Parto"
    BackgroundColor="#F2F9F8"
    Shell.NavBarIsVisible="False">

    <!-- Adicionado para corrigir a cor dos RadioButtons apenas nesta página -->
    <ContentPage.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="TextColor" Value="#333333" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout BackgroundColor="#00897B" Padding="20,18,20,12" Spacing="12">
            <Label Text="Guia Pré-Natal" FontSize="25" FontAttributes="Bold" TextColor="White" />

            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Diário" Clicked="OnDiarioClicked" BackgroundColor="Transparent" TextColor="White" />
                    <Button Text="Semanário" Clicked="OnSemanarioClicked" BackgroundColor="Transparent" TextColor="White" />
                    <Button Text="Suplementos" Clicked="OnSuplementosClicked" BackgroundColor="Transparent" TextColor="White" />
                    <Button Text="Plano de Parto" BackgroundColor="#F0F8F6" TextColor="#278F80" CornerRadius="12" />
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">

                <Border BackgroundColor="White" Stroke="#E5EFEC" Padding="16" StrokeShape="RoundRectangle 18">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Plano de Parto" FontSize="18" FontAttributes="Bold" TextColor="#263746" />
                            <Label Text="Registre suas preferências para levar ao hospital" FontSize="12" TextColor="#9AA7B3" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="#2F9E8F" Padding="10,5" StrokeThickness="0" StrokeShape="RoundRectangle 14" VerticalOptions="Start">
                            <Label x:Name="ProgressoLabel" Text="0/6" TextColor="White" FontSize="12" FontAttributes="Bold" />
                        </Border>
                    </Grid>
                </Border>

                <Border BackgroundColor="White" Stroke="#E5EFEC" Padding="14" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ACOMPANHANTE" FontSize="12" FontAttributes="Bold" TextColor="#89969E" />
                        <RadioButton Content="Marido/Parceiro" GroupName="Acompanhante" Value="Marido/Parceiro" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Mãe" GroupName="Acompanhante" Value="Mãe" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Irmã" GroupName="Acompanhante" Value="Irmã" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Doula" GroupName="Acompanhante" Value="Doula" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Amiga" GroupName="Acompanhante" Value="Amiga" CheckedChanged="OnOpcaoChanged" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" Stroke="#E5EFEC" Padding="14" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="TIPO DE PARTO PREFERIDO" FontSize="12" FontAttributes="Bold" TextColor="#89969E" />
                        <RadioButton Content="Normal" GroupName="TipoParto" Value="Normal/Vaginal" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Cesárea (se necessário)" GroupName="TipoParto" Value="Cesárea (se necessário)" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Sem preferência" GroupName="TipoParto" Value="Sem preferência" CheckedChanged="OnOpcaoChanged" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" Stroke="#E5EFEC" Padding="14" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ALÍVIO DA DOR" FontSize="12" FontAttributes="Bold" TextColor="#89969E" />
                        <RadioButton Content="Anestesia peridural" GroupName="AlivioDor" Value="Anestesia peridural" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Métodos naturais (bola, banheira)" GroupName="AlivioDor" Value="Métodos naturais (bola, banheira)" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Massagem" GroupName="AlivioDor" Value="Massagem" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Sem medicação" GroupName="AlivioDor" Value="Sem medicação" CheckedChanged="OnOpcaoChanged" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" Stroke="#E5EFEC" Padding="14" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="CORTE DO CORDÃO UMBILICAL" FontSize="12" FontAttributes="Bold" TextColor="#89969E" />
                        <RadioButton Content="Aguardar parar de pulsar" GroupName="Cordao" Value="Aguardar parar de pulsar" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Pai/acompanhante cortar" GroupName="Cordao" Value="Pai/acompanhante cortar" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Equipe médica cortar" GroupName="Cordao" Value="Equipe médica cortar" CheckedChanged="OnOpcaoChanged" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" Stroke="#E5EFEC" Padding="14" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="CONTATO PELE A PELE" FontSize="12" FontAttributes="Bold" TextColor="#89969E" />
                        <RadioButton Content="Imediato após o parto" GroupName="PelePele" Value="Imediato após o parto" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Após avaliação do bebê" GroupName="PelePele" Value="Após avaliação do bebê" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Sem preferência" GroupName="PelePele" Value="Sem preferência" CheckedChanged="OnOpcaoChanged" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" Stroke="#E5EFEC" Padding="14" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="AMAMENTAÇÃO" FontSize="12" FontAttributes="Bold" TextColor="#89969E" />
                        <RadioButton Content="Na sala de parto" GroupName="Amamentacao" Value="Na sala de parto" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Após higiene" GroupName="Amamentacao" Value="Após higiene" CheckedChanged="OnOpcaoChanged" />
                        <RadioButton Content="Conforme orientação médica" GroupName="Amamentacao" Value="Conforme orientação médica" CheckedChanged="OnOpcaoChanged" />
                    </VerticalStackLayout>
                </Border>

                <Button
                    Text="💾 Salvar Plano de Parto"
                    Clicked="OnSalvarClicked"
                    BackgroundColor="#2F9E8F"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="52" />

                <Button
                    Text="Compartilhar Plano"
                    Clicked="OnCompartilharClicked"
                    BackgroundColor="Transparent"
                    BorderColor="#B8DDD5"
                    BorderWidth="1"
                    TextColor="#278F80"
                    CornerRadius="14"
                    HeightRequest="48"
                    Margin="0,0,0,8" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" BackgroundColor="White" Padding="8" ColumnDefinitions="*,*,*,*,*">
            <VerticalStackLayout Grid.Column="0" Spacing="3">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnInicioTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="⌂" FontSize="24" HorizontalTextAlignment="Center" TextColor="#9AA7B3" />
                <Label Text="Início" FontSize="11" HorizontalTextAlignment="Center" TextColor="#9AA7B3" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="3">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAgendaMenuTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="▢" FontSize="24" HorizontalTextAlignment="Center" TextColor="#9AA7B3" />
                <Label Text="Agenda" FontSize="11" HorizontalTextAlignment="Center" TextColor="#9AA7B3" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Spacing="3">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChatMenuTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="◉" FontSize="24" HorizontalTextAlignment="Center" TextColor="#9AA7B3" />
                <Label Text="Chat" FontSize="11" HorizontalTextAlignment="Center" TextColor="#9AA7B3" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3" Spacing="3">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGuiaMenuTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="▮" FontSize="24" HorizontalTextAlignment="Center" TextColor="#2F9E8F" />
                <Label Text="Guia" FontSize="11" HorizontalTextAlignment="Center" TextColor="#2F9E8F" FontAttributes="Bold" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="4" Spacing="3">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPerfilMenuTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="♙" FontSize="24" HorizontalTextAlignment="Center" TextColor="#9AA7B3" />
                <Label Text="Perfil" FontSize="11" HorizontalTextAlignment="Center" TextColor="#9AA7B3" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>