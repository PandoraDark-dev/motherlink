<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MaternaApp.Views.GuiaDiarioPage"
    Title="Guia Pré-Natal"
    BackgroundColor="#F2F9F8"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- CABEÇALHO -->
        <VerticalStackLayout
            Grid.Row="0"
            BackgroundColor="#00897B"
            Padding="20,18,20,0"
            Spacing="14">

            <Label
                Text="Guia Pré-Natal"
                FontSize="25"
                FontAttributes="Bold"
                TextColor="White" />

            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout Spacing="18" Padding="0,0,0,12">
                    <Button Text="Diário"
                            BackgroundColor="#F0F8F6"
                            TextColor="#278F80"
                            CornerRadius="12"
                            Padding="16,8"
                            Clicked="OnDiarioClicked" />

                    <Button Text="Semanário"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            Padding="8,8"
                            Clicked="OnSemanarioClicked" />

                    <Button Text="Suplementos"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            Padding="8,8"
                            Clicked="OnSuplementosClicked" />

                    <Button Text="Plano de Parto"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            Padding="8,8"
                            Clicked="OnPlanoPartoClicked" />
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <!-- CONTEÚDO -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- HUMOR E SONO -->
                <Border BackgroundColor="White"
                        Stroke="#E5EFEC"
                        StrokeThickness="1"
                        Padding="18"
                        StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout Spacing="12">
                        <Label Text="HOJE"
                               FontSize="13"
                               TextColor="#87949B" />

                        <Label Text="Como você está hoje?"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#263746" />

                        <Label Text="HUMOR"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#77858F"
                               Margin="0,8,0,0" />

                        <Grid ColumnDefinitions="*,*,*,*,*"
                              ColumnSpacing="4">
                            <CheckBox x:Name="HumorFeliz"
                                      Grid.Column="0"
                                      Color="#2F9E8F"
                                      CheckedChanged="OnHumorChanged" />
                            <CheckBox x:Name="HumorTranquila"
                                      Grid.Column="1"
                                      Color="#2F9E8F"
                                      CheckedChanged="OnHumorChanged" />
                            <CheckBox x:Name="HumorNeutra"
                                      Grid.Column="2"
                                      Color="#2F9E8F"
                                      CheckedChanged="OnHumorChanged" />
                            <CheckBox x:Name="HumorCansada"
                                      Grid.Column="3"
                                      Color="#2F9E8F"
                                      CheckedChanged="OnHumorChanged" />
                            <CheckBox x:Name="HumorTriste"
                                      Grid.Column="4"
                                      Color="#2F9E8F"
                                      CheckedChanged="OnHumorChanged" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*,*"
                              ColumnSpacing="4">
                            <Label Grid.Column="0" Text="Feliz"
                                   FontSize="11" HorizontalTextAlignment="Center"
                                   TextColor="#59666F" />
                            <Label Grid.Column="1" Text="Tranquila"
                                   FontSize="10" HorizontalTextAlignment="Center"
                                   TextColor="#59666F" />
                            <Label Grid.Column="2" Text="Neutra"
                                   FontSize="11" HorizontalTextAlignment="Center"
                                   TextColor="#59666F" />
                            <Label Grid.Column="3" Text="Cansada"
                                   FontSize="10" HorizontalTextAlignment="Center"
                                   TextColor="#59666F" />
                            <Label Grid.Column="4" Text="Triste"
                                   FontSize="11" HorizontalTextAlignment="Center"
                                   TextColor="#59666F" />
                        </Grid>

                        <Label Text="SONO (HORAS)"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#77858F"
                               Margin="0,8,0,0" />

                        <Grid ColumnDefinitions="*,*,*,*,*,*"
                              ColumnSpacing="5">
                            <Button x:Name="Sono0" Grid.Column="0" Text="0"
                                    Clicked="OnSonoClicked"
                                    BackgroundColor="#F0F3F7" TextColor="#65717B"
                                    CornerRadius="22" Padding="0" />
                            <Button x:Name="Sono2" Grid.Column="1" Text="2"
                                    Clicked="OnSonoClicked"
                                    BackgroundColor="#F0F3F7" TextColor="#65717B"
                                    CornerRadius="22" Padding="0" />
                            <Button x:Name="Sono4" Grid.Column="2" Text="4"
                                    Clicked="OnSonoClicked"
                                    BackgroundColor="#2F9E8F" TextColor="White"
                                    CornerRadius="22" Padding="0" />
                            <Button x:Name="Sono6" Grid.Column="3" Text="6"
                                    Clicked="OnSonoClicked"
                                    BackgroundColor="#F0F3F7" TextColor="#65717B"
                                    CornerRadius="22" Padding="0" />
                            <Button x:Name="Sono8" Grid.Column="4" Text="8"
                                    Clicked="OnSonoClicked"
                                    BackgroundColor="#F0F3F7" TextColor="#65717B"
                                    CornerRadius="22" Padding="0" />
                            <Button x:Name="Sono10" Grid.Column="5" Text="10"
                                    Clicked="OnSonoClicked"
                                    BackgroundColor="#F0F3F7" TextColor="#65717B"
                                    CornerRadius="22" Padding="0" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                            <Label Text="Pouco"
                                   TextColor="#9AA5AC"
                                   FontSize="12" />
                            <Label Grid.Column="1"
                                   Text="Muito"
                                   HorizontalTextAlignment="End"
                                   TextColor="#9AA5AC"
                                   FontSize="12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- SINTOMAS -->
                <Border BackgroundColor="White"
                        Stroke="#E5EFEC"
                        StrokeThickness="1"
                        Padding="18"
                        StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="SINTOMAS DE HOJE"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#77858F"
                               Margin="0,0,0,8" />

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="SintomaEnjoo" Color="#2F9E8F" />
                            <Label Text="Enjoo" VerticalOptions="Center"
                                   TextColor="#59666F" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="SintomaCansaco" Color="#2F9E8F" />
                            <Label Text="Cansaço" VerticalOptions="Center"
                                   TextColor="#59666F" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="SintomaCabeca" Color="#2F9E8F" />
                            <Label Text="Dor de cabeça" VerticalOptions="Center"
                                   TextColor="#59666F" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="SintomaInchaco" Color="#2F9E8F" />
                            <Label Text="Inchaço nos pés" VerticalOptions="Center"
                                   TextColor="#59666F" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="SintomaAzia" Color="#2F9E8F" />
                            <Label Text="Azia" VerticalOptions="Center"
                                   TextColor="#59666F" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- MOVIMENTOS DO BEBÊ -->
                <Border BackgroundColor="White"
                        Stroke="#E5EFEC"
                        StrokeThickness="1"
                        Padding="18"
                        StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout Spacing="12">
                        <Label Text="MOVIMENTOS DO BEBÊ"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#77858F" />

                        <Grid ColumnDefinitions="*,*,*,*,*,*,*"
                              ColumnSpacing="5"
                              HeightRequest="100"
                              VerticalOptions="End">

                            <BoxView Grid.Column="0" HeightRequest="22"
                                     VerticalOptions="End"
                                     BackgroundColor="#B4E4DC" />
                            <BoxView Grid.Column="1" HeightRequest="48"
                                     VerticalOptions="End"
                                     BackgroundColor="#B4E4DC" />
                            <BoxView Grid.Column="2" HeightRequest="35"
                                     VerticalOptions="End"
                                     BackgroundColor="#B4E4DC" />
                            <BoxView Grid.Column="3" HeightRequest="65"
                                     VerticalOptions="End"
                                     BackgroundColor="#2F9E8F" />
                            <BoxView Grid.Column="4" HeightRequest="42"
                                     VerticalOptions="End"
                                     BackgroundColor="#B4E4DC" />
                            <BoxView Grid.Column="5" HeightRequest="28"
                                     VerticalOptions="End"
                                     BackgroundColor="#B4E4DC" />
                            <BoxView Grid.Column="6" HeightRequest="54"
                                     VerticalOptions="End"
                                     BackgroundColor="#B4E4DC" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                            <Label Text="Dom" FontSize="10" TextColor="#87949B"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Seg" FontSize="10" TextColor="#87949B"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="Ter" FontSize="10" TextColor="#87949B"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Column="3" Text="Qua" FontSize="10" TextColor="#87949B"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Column="4" Text="Qui" FontSize="10" TextColor="#87949B"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Column="5" Text="Sex" FontSize="10" TextColor="#87949B"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Column="6" Text="Sáb" FontSize="10" TextColor="#87949B"
                                   HorizontalTextAlignment="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EDF1F0" />

                        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                              ColumnSpacing="14">
                            <Label Text="Registrar agora"
                                   VerticalOptions="Center"
                                   TextColor="#59666F" />

                            <Button Grid.Column="1"
                                    Text="−"
                                    Clicked="OnMovimentoMenosClicked"
                                    BackgroundColor="White"
                                    BorderColor="#E5E9E8"
                                    BorderWidth="1"
                                    TextColor="#59666F"
                                    CornerRadius="22"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    Padding="0" />

                            <Label x:Name="MovimentosLabel"
                                   Grid.Column="2"
                                   Text="0"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="#263746" />

                            <Button Grid.Column="3"
                                    Text="+"
                                    Clicked="OnMovimentoMaisClicked"
                                    BackgroundColor="#2F9E8F"
                                    TextColor="White"
                                    CornerRadius="22"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    Padding="0" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- OBSERVAÇÕES -->
                <Border BackgroundColor="White"
                        Stroke="#E5EFEC"
                        Padding="16"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="OBSERVAÇÕES"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#77858F" />
                        <Editor x:Name="ObservacoesEditor"
                                Placeholder="Escreva uma observação..."
                                AutoSize="TextChanges"
                                MinimumHeightRequest="80"
                                BackgroundColor="#F8FBFA"
                                TextColor="#263746" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Salvar Registro de Hoje"
                        Clicked="OnSalvarClicked"
                        BackgroundColor="#2F9E8F"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="17"
                        CornerRadius="16"
                        HeightRequest="62"
                        Margin="0,0,0,8" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- MENU INFERIOR -->
        <Grid Grid.Row="2"
              BackgroundColor="White"
              Padding="8,8"
              ColumnDefinitions="*,*,*,*,*">

            <VerticalStackLayout Grid.Column="0" Spacing="3">
                <Label Text="⌂" FontSize="24"
                       HorizontalTextAlignment="Center"
                       TextColor="#9AA7B3" />
                <Label Text="Início" FontSize="11"
                       HorizontalTextAlignment="Center"
                       TextColor="#9AA7B3" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="3">
                <Label Text="▢" FontSize="24"
                       HorizontalTextAlignment="Center"
                       TextColor="#9AA7B3" />
                <Label Text="Agenda" FontSize="11"
                       HorizontalTextAlignment="Center"
                       TextColor="#9AA7B3" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Spacing="3">
                <Label Text="◉" FontSize="24"
                       HorizontalTextAlignment="Center"
                       TextColor="#9AA7B3" />
                <Label Text="Chat" FontSize="11"
                       HorizontalTextAlignment="Center"
                       TextColor="#9AA7B3" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3" Spacing="3">
                <Label Text="▮" FontSize="24"
                       HorizontalTextAlignment="Center"
                       TextColor="#2F9E8F" />
                <Label Text="Guia" FontSize="11"
                       HorizontalTextAlignment="Center"
                       TextColor="#2F9E8F"
                       FontAttributes="Bold" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="4" Spacing="3">
                <Label Text="♙" FontSize="24"
                       HorizontalTextAlignment="Center"
                       TextColor="#9AA7B3" />
                <Label Text="Perfil" FontSize="11"
                       HorizontalTextAlignment="Center"
                       TextColor="#9AA7B3" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>