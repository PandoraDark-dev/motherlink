<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MaternaApp.Views.PainelProfissionalPage"
             BackgroundColor="#F2F9F8"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Grid ColumnDefinitions="210,310,*">

            <Grid Grid.Column="0" BackgroundColor="#17685F" Padding="20">
                <VerticalStackLayout Spacing="25">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="MotherLink" FontSize="25" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Área profissional" FontSize="13" TextColor="#D2EAE5"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#43877F"/>

                    <VerticalStackLayout Spacing="18">
                        <Label Text="PAINEL" TextColor="#B9D9D3" FontSize="11" FontAttributes="Bold"/>
                        <Label Text="▦  Dashboard" TextColor="White" FontSize="15"/>
                        <Label Text="♡  Gestantes" TextColor="White" FontSize="15"/>
                        <Label Text="✉  Mensagens" TextColor="White" FontSize="15"/>
                        <Label Text="⌕  Busca ativa" TextColor="White" FontSize="15">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAbrirBuscaAtivaTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="▤  e-SUS" TextColor="White" FontSize="15">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAbrirEsusTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>

                    <Button Text="Sair"
                            BackgroundColor="#D96C6C"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="42"
                            Clicked="OnSairClicked"/>

                    <VerticalStackLayout VerticalOptions="EndAndExpand" Spacing="5">
                        <Label Text="MotherLink" TextColor="White" FontAttributes="Bold"/>
                        <Label Text="Acompanhamento materno" TextColor="#D2EAE5" FontSize="11"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <Grid Grid.Column="1" BackgroundColor="White" Padding="18"
                  RowDefinitions="Auto,Auto,Auto,*">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Gestantes" FontSize="23" FontAttributes="Bold" TextColor="#244A45"/>
                    <Label Text="Acompanhe suas pacientes" FontSize="12" TextColor="#81938F"/>
                </VerticalStackLayout>

                <Button Grid.Row="1" Text="+ Nova gestante"
                        BackgroundColor="#319C8C" TextColor="White"
                        CornerRadius="10" HeightRequest="43"
                        Margin="0,18,0,12"
                        Clicked="OnAbrirModalCadastroClicked"/>

                <SearchBar Grid.Row="2" x:Name="txtBuscarGestante"
                           Placeholder="Buscar gestante"
                           BackgroundColor="#F2F9F8"
                           TextColor="#244A45"
                           PlaceholderColor="#91A39E"
                           TextChanged="OnBuscarGestanteTextChanged"/>

                <CollectionView Grid.Row="3" x:Name="ListaGestantes"
                                SelectionMode="Single"
                                SelectionChanged="OnGestanteSelecionadaChanged"
                                Margin="0,12,0,0">
                    <CollectionView.EmptyView>
                        <Label Text="Nenhuma gestante cadastrada."
                               TextColor="#81938F"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="12" Margin="0,4"
                                   CornerRadius="10" HasShadow="False"
                                   BackgroundColor="#F2F9F8" BorderColor="#E1EEEA">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Nome}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="#244A45"/>
                                    <Label Text="{Binding CPF, StringFormat='CPF: {0}'}"
                                           FontSize="12" TextColor="#81938F"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <ScrollView Grid.Column="2">
                <VerticalStackLayout Padding="25" Spacing="20">

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Painel de acompanhamento"
                                   FontSize="23" FontAttributes="Bold"
                                   TextColor="#244A45"/>
                            <Label Text="Visão geral do acompanhamento pré-natal"
                                   FontSize="13" TextColor="#81938F"/>
                        </VerticalStackLayout>
                        <Frame Grid.Column="1" Padding="12,8"
                               CornerRadius="20" HasShadow="False"
                               BackgroundColor="#E1F3EF">
                            <Label Text="●  Profissional"
                                   TextColor="#287D72" FontSize="12"/>
                        </Frame>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Frame Padding="15" CornerRadius="12" HasShadow="False" BackgroundColor="White">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Gestantes" FontSize="12" TextColor="#81938F"/>
                                <Label x:Name="lblTotalGestantes" Text="0"
                                       FontSize="25" FontAttributes="Bold" TextColor="#319C8C"/>
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Column="1" Padding="15" CornerRadius="12" HasShadow="False" BackgroundColor="White">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Em acompanhamento" FontSize="12" TextColor="#81938F"/>
                                <Label x:Name="lblEmAcompanhamento" Text="0"
                                       FontSize="25" FontAttributes="Bold" TextColor="#319C8C"/>
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Column="2" Padding="15" CornerRadius="12" HasShadow="False" BackgroundColor="White">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Selecionada" FontSize="12" TextColor="#81938F"/>
                                <Label x:Name="lblStatusGestante" Text="Nenhuma"
                                       FontSize="16" FontAttributes="Bold" TextColor="#319C8C"/>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <Frame Padding="20" CornerRadius="14" HasShadow="False" BackgroundColor="White">
                        <VerticalStackLayout Spacing="15">
                            <Label Text="Dados da gestante" FontSize="17"
                                   FontAttributes="Bold" TextColor="#244A45"/>
                            <Label x:Name="lblNomeGestanteExemplo"
                                   Text="Selecione uma gestante"
                                   FontSize="21" FontAttributes="Bold"
                                   TextColor="#319C8C"/>
                            <BoxView HeightRequest="1" Color="#E8EFED"/>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="15" RowSpacing="15">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="CPF" FontSize="12" TextColor="#81938F"/>
                                    <Label x:Name="lblCpfGestante" Text="Não informado"
                                           FontSize="14" TextColor="#244A45"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Cartão SUS" FontSize="12" TextColor="#81938F"/>
                                    <Label x:Name="lblSusGestante" Text="Não informado"
                                           FontSize="14" TextColor="#244A45"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Spacing="4">
                                    <Label Text="DUM" FontSize="12" TextColor="#81938F"/>
                                    <Label x:Name="lblDumGestante" Text="Não informada"
                                           FontSize="14" TextColor="#244A45"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                    <Label Text="DPP" FontSize="12" TextColor="#81938F"/>
                                    <Label x:Name="lblDppGestante" Text="Não informada"
                                           FontSize="14" TextColor="#244A45"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <Button x:Name="btnAgendarConsulta"
                            Text="+ Agendar consulta"
                            BackgroundColor="#319C8C"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="48"
                            IsEnabled="False"
                            Clicked="OnAbrirModalConsultaClicked"/>

                    <Button x:Name="btnGerenciarSuplementos"
                            Text="Gerenciar suplementos"
                            BackgroundColor="#347F80"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="48"
                            IsEnabled="False"
                            Clicked="OnAbrirSuplementosClicked"/>

                    <Button x:Name="btnAbrirChat"
                            Text="Conversar com gestante"
                            BackgroundColor="#347F80"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="48"
                            IsEnabled="False"
                            Clicked="OnAbrirChatClicked"/>

                    <Frame Padding="20" CornerRadius="14" HasShadow="False" BackgroundColor="White">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Acompanhamento" FontSize="17"
                                   FontAttributes="Bold" TextColor="#244A45"/>
                            <Label Text="Selecione uma gestante na lista para visualizar os dados disponíveis."
                                   FontSize="13" TextColor="#81938F"/>
                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <Grid x:Name="ModalCadastroGrid" IsVisible="False"
              BackgroundColor="#80000000" Padding="20">
            <ScrollView VerticalOptions="Center">
                <Frame Padding="22" CornerRadius="16"
                       HasShadow="True" BackgroundColor="White"
                       MaximumWidthRequest="450"
                       HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="13">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Cadastrar gestante" FontSize="20"
                                   FontAttributes="Bold" TextColor="#244A45"/>
                            <Button Grid.Column="1" Text="✕"
                                    BackgroundColor="Transparent"
                                    TextColor="#81938F"
                                    Clicked="OnFecharModalCadastroClicked"/>
                        </Grid>

                        <Label Text="Nome completo" FontSize="12" TextColor="#526B66"/>
                        <Entry x:Name="txtNomeGestante"
                               Placeholder="Nome da gestante"
                               TextColor="#244A45"
                               PlaceholderColor="#91A39E"
                               BackgroundColor="#F2F9F8"/>

                        <Label Text="CPF" FontSize="12" TextColor="#526B66"/>
                        <Entry x:Name="txtCpfGestante"
                               Placeholder="Somente números"
                               Keyboard="Numeric"
                               MaxLength="11"
                               TextColor="#244A45"
                               PlaceholderColor="#91A39E"
                               BackgroundColor="#F2F9F8"/>

                        <Label Text="Cartão SUS" FontSize="12" TextColor="#526B66"/>
                        <Entry x:Name="txtCartaoSUSGestante"
                               Placeholder="Número do Cartão SUS"
                               Keyboard="Numeric"
                               TextColor="#244A45"
                               PlaceholderColor="#91A39E"
                               BackgroundColor="#F2F9F8"/>

                        <Label Text="Senha inicial" FontSize="12" TextColor="#526B66"/>
                        <Entry x:Name="txtSenhaInicialGestante"
                               Placeholder="Crie uma senha"
                               IsPassword="True"
                               TextColor="#244A45"
                               PlaceholderColor="#91A39E"
                               BackgroundColor="#F2F9F8"/>

                        <Label Text="Data da última menstruação (DUM)" FontSize="12" TextColor="#526B66"/>
                        <DatePicker x:Name="dpDUMGestante"
                                    Format="dd/MM/yyyy"
                                    TextColor="#244A45"
                                    BackgroundColor="#F2F9F8"/>

                        <Label Text="Data provável do parto (DPP)" FontSize="12" TextColor="#526B66"/>
                        <DatePicker x:Name="dpDPPGestante"
                                    Format="dd/MM/yyyy"
                                    TextColor="#244A45"
                                    BackgroundColor="#F2F9F8"/>

                        <Button Text="Cadastrar gestante"
                                BackgroundColor="#319C8C" TextColor="White"
                                CornerRadius="10" HeightRequest="48"
                                Margin="0,8,0,0"
                                Clicked="OnSalvarNovaGestanteClicked"/>
                    </VerticalStackLayout>
                </Frame>
            </ScrollView>
        </Grid>

        <Grid x:Name="ModalConsultaGrid"
              IsVisible="False"
              BackgroundColor="#80000000"
              Padding="20">
            <ScrollView VerticalOptions="Center">
                <Frame Padding="22"
                       CornerRadius="16"
                       HasShadow="True"
                       BackgroundColor="White"
                       MaximumWidthRequest="450"
                       HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="13">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Agendar consulta"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#244A45"/>
                            <Button Grid.Column="1"
                                    Text="✕"
                                    BackgroundColor="Transparent"
                                    TextColor="#81938F"
                                    Clicked="OnFecharModalConsultaClicked"/>
                        </Grid>

                        <Label Text="Gestante selecionada"
                               FontSize="12"
                               TextColor="#526B66"/>
                        <Label x:Name="lblGestanteConsulta"
                               Text="Nenhuma gestante"
                               FontAttributes="Bold"
                               TextColor="#319C8C"/>

                        <Label Text="Data" FontSize="12" TextColor="#526B66"/>
                        <DatePicker x:Name="dpDataConsulta"
                                    Format="dd/MM/yyyy"
                                    TextColor="#244A45"
                                    BackgroundColor="#F2F9F8"/>

                        <Label Text="Horário" FontSize="12" TextColor="#526B66"/>
                        <TimePicker x:Name="tpHorarioConsulta"
                                    Format="HH:mm"
                                    TextColor="#244A45"
                                    BackgroundColor="#F2F9F8"/>

                        <Label Text="Tipo de consulta" FontSize="12" TextColor="#526B66"/>
                        <Picker x:Name="pkTipoConsulta"
                                Title="Selecione o tipo"
                                TextColor="#244A45"
                                BackgroundColor="#F2F9F8">
                            <Picker.Items>
                                <x:String>Pré-natal</x:String>
                                <x:String>Ultrassonografia</x:String>
                                <x:String>Exames</x:String>
                                <x:String>Retorno</x:String>
                                <x:String>Outro</x:String>
                            </Picker.Items>
                        </Picker>

                        <Label Text="Observações" FontSize="12" TextColor="#526B66"/>
                        <Editor x:Name="txtObservacoesConsulta"
                                Placeholder="Informações adicionais"
                                AutoSize="TextChanges"
                                TextColor="#244A45"
                                BackgroundColor="#F2F9F8"/>

                        <Button Text="Salvar consulta"
                                BackgroundColor="#319C8C"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="48"
                                Clicked="OnSalvarConsultaClicked"/>
                    </VerticalStackLayout>
                </Frame>
            </ScrollView>
        </Grid>

        <Grid x:Name="ModalBuscaAtivaGrid"
              IsVisible="False"
              BackgroundColor="#80000000"
              Padding="20">

            <Frame Padding="22"
                   CornerRadius="16"
                   HasShadow="True"
                   BackgroundColor="White"
                   MaximumWidthRequest="650"
                   VerticalOptions="Center"
                   HorizontalOptions="Center">

                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="15">

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Busca ativa"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#244A45"/>
                            <Label Text="Gestantes que precisam de acompanhamento"
                                   FontSize="12"
                                   TextColor="#81938F"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="✕"
                                BackgroundColor="Transparent"
                                TextColor="#81938F"
                                Clicked="OnFecharBuscaAtivaClicked"/>
                    </Grid>

                    <BoxView Grid.Row="1"
                             HeightRequest="1"
                             Color="#E8EFED"/>

                    <CollectionView Grid.Row="2"
                                    x:Name="ListaBuscaAtiva">
                        <CollectionView.EmptyView>
                            <Label Text="Nenhuma gestante precisa de busca ativa."
                                   TextColor="#81938F"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="14"
                                       Margin="0,4"
                                       CornerRadius="10"
                                       HasShadow="False"
                                       BackgroundColor="#F2F9F8"
                                       BorderColor="#E1EEEA">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Nome}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#244A45"/>
                                        <Label Text="{Binding CPF, StringFormat='CPF: {0}'}"
                                               FontSize="12"
                                               TextColor="#526B66"/>
                                        <Label Text="{Binding CartaoSUS, StringFormat='Cartão SUS: {0}'}"
                                               FontSize="12"
                                               TextColor="#526B66"/>
                                        <Label Text="{Binding UltimaConsulta, StringFormat='Última consulta: {0:dd/MM/yyyy}'}"
                                               FontSize="12"
                                               TextColor="#526B66"/>
                                        <Label Text="{Binding DiasSemConsulta, StringFormat='Dias sem consulta: {0}'}"
                                               FontSize="12"
                                               TextColor="#526B66"/>
                                        <Label Text="{Binding Situacao}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#C07835"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
