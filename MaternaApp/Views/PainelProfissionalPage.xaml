<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MaternaApp.Views.PainelProfissionalPage"
             BackgroundColor="#F2F9F8"
             Title="Painel do Profissional">

    <Grid>
        <!-- CONTEÚDO PRINCIPAL DA PÁGINA -->
        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="20">

                <!-- Cabeçalho -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Painel Profissional" FontSize="22" FontAttributes="Bold" TextColor="#2C3E50"/>
                        <Label Text="Gerenciamento de Gestantes" FontSize="12" TextColor="#7F8C8D"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="1" 
                            Text="+ Nova Gestante" 
                            BackgroundColor="#1A9E85" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="8" 
                            FontSize="12"
                            Clicked="OnAbrirModalCadastroClicked"/>
                </Grid>

                <!-- Tabela / Lista de Gestantes -->
                <Border Stroke="#E0E0E0" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Gestantes Cadastradas" FontSize="14" FontAttributes="Bold" TextColor="#2C3E50"/>
                        <BoxView HeightRequest="1" Color="#E0E0E0"/>

                        <!-- Exemplo de Item da Lista / Gestante -->
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center" Padding="5,0">
                            <VerticalStackLayout Grid.Column="0">
                                <Label x:Name="lblNomeGestanteExemplo" Text="Maria Silva" FontAttributes="Bold" FontSize="13" TextColor="#2C3E50"/>
                                <Label Text="IG: 24 semanas | UBS Silveiras" FontSize="11" TextColor="#7F8C8D"/>
                            </VerticalStackLayout>

                            <!-- Ação: Trocar Senha -->
                            <Button Grid.Column="1"
                                    Text="Alterar Senha"
                                    FontSize="11"
                                    BackgroundColor="#FFF3E0"
                                    TextColor="#D35400"
                                    CornerRadius="6"
                                    HeightRequest="32"
                                    Padding="10,0"
                                    Clicked="OnTrocarSenhaClicked"/>

                            <!-- Outra ação exemplo -->
                            <Button Grid.Column="2"
                                    Text="Detalhes"
                                    FontSize="11"
                                    BackgroundColor="#E8F8F5"
                                    TextColor="#1A9E85"
                                    CornerRadius="6"
                                    HeightRequest="32"
                                    Padding="10,0"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================== MODAL DE CADASTRO DE GESTANTE ==================== -->
        <Grid x:Name="ModalCadastroGrid" 
              BackgroundColor="#80000000" 
              IsVisible="False" 
              HorizontalOptions="Fill" 
              VerticalOptions="Fill">

            <Border BackgroundColor="White" 
                    Stroke="Transparent" 
                    StrokeShape="RoundRectangle 16" 
                    WidthRequest="380" 
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    Padding="20">
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Cadastrar Nova Gestante" FontAttributes="Bold" FontSize="16" TextColor="#2C3E50" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="✕" FontSize="18" TextColor="#7F8C8D" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFecharModalCadastroTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,0,0,5"/>

                    <Entry x:Name="txtNomeGestante" Placeholder="Nome completo" FontSize="12"/>
                    <Entry x:Name="txtCpfGestante" Placeholder="CPF" Keyboard="Numeric" FontSize="12"/>
                    <Entry x:Name="txtSenhaInicialGestante" Placeholder="Senha de acesso" IsPassword="True" FontSize="12"/>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Text="Cancelar" 
                                BackgroundColor="#F0F0F0" 
                                TextColor="#555555" 
                                CornerRadius="8" 
                                FontSize="12" 
                                Clicked="OnFecharModalCadastroClicked"/>

                        <Button Text="Cadastrar" 
                                BackgroundColor="#1A9E85" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                CornerRadius="8" 
                                FontSize="12" 
                                Clicked="OnSalvarNovaGestanteClicked"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ==================== MODAL DE TROCA DE SENHA ==================== -->
        <Grid x:Name="ModalTrocarSenhaGrid" 
              BackgroundColor="#80000000" 
              IsVisible="False" 
              HorizontalOptions="Fill" 
              VerticalOptions="Fill">

            <Border BackgroundColor="White" 
                    Stroke="Transparent" 
                    StrokeShape="RoundRectangle 16" 
                    WidthRequest="380" 
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    Padding="20">
                <VerticalStackLayout Spacing="12">

                    <!-- Cabeçalho do Modal -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Alterar Senha da Gestante" FontAttributes="Bold" FontSize="16" TextColor="#2C3E50" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="✕" FontSize="18" TextColor="#7F8C8D" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFecharModalTrocarSenhaTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,0,0,5"/>

                    <!-- Identificação da Gestante -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="GESTANTE SELECIONADA" FontSize="10" FontAttributes="Bold" TextColor="#1A9E85"/>
                        <Label x:Name="lblNomeGestanteSenha" Text="Maria Silva" FontSize="13" FontAttributes="Bold" TextColor="#2C3E50"/>
                    </VerticalStackLayout>

                    <!-- Campos de Senha com Olhinho -->
                    <Label Text="NOVA CREDENCIAL" FontSize="10" FontAttributes="Bold" TextColor="#1A9E85" Margin="0,5,0,0"/>

                    <!-- Campo: Nova Senha -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry x:Name="txtNovaSenhaGestante" 
                               Grid.Column="0"
                               Placeholder="Digite a nova senha (mín. 6 caracteres)" 
                               IsPassword="True" 
                               FontSize="12"/>
                        <ImageButton x:Name="btnToggleNovaSenha"
                                     Grid.Column="1"
                                     Source="eye_closed.png"
                                     HeightRequest="22"
                                     WidthRequest="22"
                                     Margin="5,0,5,0"
                                     VerticalOptions="Center"
                                     Clicked="OnToggleNovaSenhaClicked"/>
                    </Grid>

                    <!-- Campo: Confirmar Nova Senha -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry x:Name="txtConfirmarNovaSenhaGestante" 
                               Grid.Column="0"
                               Placeholder="Confirme a nova senha" 
                               IsPassword="True" 
                               FontSize="12"/>
                        <ImageButton x:Name="btnToggleConfirmarSenha"
                                     Grid.Column="1"
                                     Source="eye_closed.png"
                                     HeightRequest="22"
                                     WidthRequest="22"
                                     Margin="5,0,5,0"
                                     VerticalOptions="Center"
                                     Clicked="OnToggleConfirmarSenhaClicked"/>
                    </Grid>

                    <!-- Botões de Ação -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Text="Cancelar" 
                                BackgroundColor="#F0F0F0" 
                                TextColor="#555555" 
                                CornerRadius="8" 
                                FontSize="12" 
                                Clicked="OnFecharModalTrocarSenhaClicked"/>

                        <Button Text="Salvar Senha" 
                                BackgroundColor="#F39C12" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                CornerRadius="8" 
                                FontSize="12" 
                                Clicked="OnSalvarNovaSenhaClicked"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>