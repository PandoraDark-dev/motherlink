<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MaternaApp.Views.HomeGestantePage"
             BackgroundColor="#F2F9F8"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="15" Padding="0,0,0,20">

                <VerticalStackLayout BackgroundColor="#00897B"
                                     Padding="20,40,20,20"
                                     Spacing="15">

                    <Label x:Name="lblNomeGestante"
                           Text="Olá!"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Border BackgroundColor="#2FA592"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 12"
                            Padding="15">

                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Sua gestação"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"/>

                                <Label x:Name="lblPercentual"
                                       Grid.Column="1"
                                       Text="0%"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                            </Grid>

                            <Label x:Name="lblSemanaGestacao"
                                   Text="Calculando semanas..."
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="White"/>

                            <Label Text="Acompanhamento calculado pela DUM"
                                   FontSize="12"
                                   TextColor="#D1F2EB"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Padding="15" Spacing="12">

                    <Border BackgroundColor="White"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 12"
                            Padding="15">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAgendaTapped"/>
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="15">
                            <Label Text="📅"
                                   FontSize="24"
                                   VerticalOptions="Center"/>

                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="MINHA AGENDA"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="#7F8C8D"/>

                                <Label Text="Consultar consultas"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#2C3E50"/>

                                <Label Text="Acesse seus agendamentos"
                                       FontSize="11"
                                       TextColor="#7F8C8D"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="White"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 12"
                            Padding="15">

                        <VerticalStackLayout Spacing="12">
                            <Label Text="Minha Gestação"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#2C3E50"/>

                            <HorizontalStackLayout Spacing="20"
                                                   HorizontalOptions="Center">

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Dias restantes"
                                           FontSize="11"
                                           TextColor="#7F8C8D"/>

                                    <Label x:Name="lblDiasRestantes"
                                           Text="Calculando..."
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#1A9E85"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="#E8EFED"/>

                            <Grid ColumnDefinitions="*,*">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="DUM"
                                           FontSize="11"
                                           TextColor="#7F8C8D"/>

                                    <Label x:Name="lblDum"
                                           Text="--/--/----"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="4">
                                    <Label Text="DPP"
                                           FontSize="11"
                                           TextColor="#7F8C8D"/>

                                    <Label x:Name="lblDpp"
                                           Text="--/--/----"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 12"
                            Padding="15">

                        <Button Text="🚑 Acionar Emergência"
                                BackgroundColor="#E74C3C"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="45"/>
                    </Border>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              BackgroundColor="White"
              HeightRequest="60"
              ColumnDefinitions="*,*,*,*,*">

            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <Label Text="🏠"
                       FontSize="16"
                       HorizontalOptions="Center"/>
                <Label Text="Início"
                       FontSize="10"
                       TextColor="#1A9E85"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAgendaTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="📅" FontSize="16" HorizontalOptions="Center"/>
                <Label Text="Agenda" FontSize="10" TextColor="#7F8C8D" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChatTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="💬" FontSize="16" HorizontalOptions="Center"/>
                <Label Text="Chat" FontSize="10" TextColor="#7F8C8D" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGuiaTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="📖" FontSize="16" HorizontalOptions="Center"/>
                <Label Text="Guia" FontSize="10" TextColor="#7F8C8D" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="4"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPerfilTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="👤" FontSize="16" HorizontalOptions="Center"/>
                <Label Text="Perfil" FontSize="10" TextColor="#7F8C8D" HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </Grid>
    </Grid>
</ContentPage>
